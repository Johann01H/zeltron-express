# URL pública de la tienda
NEXT_PUBLIC_SITE_URL=https://zeltronexpress.com

# Endpoint WPGraphQL del backend. Si se deja vacío, se usa el catálogo de respaldo (lib/data/seed.ts).
WORDPRESS_GRAPHQL_URL=https://admin.zeltronexpress.com/graphql

# Secreto compartido con el plugin zeltron-core (pedidos y revalidación de caché).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZELTRON_API_SECRET=
NEXT_PUBLIC_WP_ADMIN_URL=https://admin.zeltronexpress.com/wp-admin/

# ---------------------------------------------------------------------------
# Bot de WhatsApp (Cloud API de Meta). Ver docs/WHATSAPP-BOT.md
# Número al que llevan los botones de WhatsApp de la tienda (solo dígitos con indicativo).
NEXT_PUBLIC_WHATSAPP_NUMBER=573025931994
# Token permanente del usuario del sistema (Meta Business → Usuarios del sistema).
WHATSAPP_TOKEN=
# «Identificador del número de teléfono» (WhatsApp → Configuración de la API). No es el número.
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que inventas y pegas igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app (developers.facebook.com → Configuración de la app → Básica).
WHATSAPP_APP_SECRET=
# Opcional: número de los asesores si es distinto al del bot. Si es el mismo (coexistencia), el bot se pausa y responden en el mismo chat.
WHATSAPP_ADVISOR_NUMBER=
